{
  "name": "lor-dapp-web3",
  "version": "1.0.0",
  "description": "Decentralized Letter of Recommendation (LoR) DApp on Ethereum Sepolia & Hardhat",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "capture-screenshots": "node scripts/captureScreenshots.cjs"
  },
  "keywords": [
    "solidity",
    "hardhat",
    "web3",
    "ethereum",
    "sepolia",
    "dapp",
    "ethers",
    "react"
  ],
  "author": "Sriharsha (ksr2005)",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^18.0.9",
    "hardhat": "^2.29.1",
    "puppeteer-core": "^25.16.0"
  }
}
